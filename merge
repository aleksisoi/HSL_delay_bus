import sqlite3
conn = sqlite3.connect("route_all.db")
conn.execute("ATTACH DATABASE '/home/soal/route_all.db' AS other")
conn.execute("""
INSERT INTO stoptimes (service_date, route, trip_id, stop_position, stop_id,
                       scheduled_departure_sec, delay_seconds, is_realtime)
SELECT service_date, route, trip_id, stop_position, stop_id,
       scheduled_departure_sec, delay_seconds, is_realtime
FROM other.stoptimes WHERE true
ON CONFLICT (service_date, trip_id, stop_position) DO UPDATE SET
    delay_seconds = excluded.delay_seconds,
    is_realtime = excluded.is_realtime
WHERE excluded.is_realtime = 1 OR stoptimes.is_realtime = 0
""")
conn.commit()
print(conn.execute("select count(*) from stoptimes").fetchone())